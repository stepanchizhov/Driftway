# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never contain a real secret. Nothing here is one: a SPA client id is public
# by design (it ships inside the bundle), and the API audience is an
# identifier rather than a credential. The client SECRET on the Auth0
# "Custom API Client" is a secret and belongs nowhere near the frontend.
#
# Vite only exposes variables prefixed VITE_, and it inlines them at build
# time - so changing any of these means restarting the dev server.

# Where the backend lives. Empty in dev: vite proxies /api to :8000.
VITE_API_BASE=

# --- Auth0 -----------------------------------------------------------------
# Leave all three blank to run without accounts. The app then behaves exactly
# as it did before sign-in existed, which is also what the backend does when
# AUTH0_DOMAIN and AUTH0_AUDIENCE are unset. Partially filling them in is the
# one state to avoid.

VITE_AUTH0_DOMAIN=dev-2611pu0zldcvdz07.uk.auth0.com

# The Single Page Application's client id - NOT the Custom API Client's.
VITE_AUTH0_CLIENT_ID=

# Must match AUTH0_AUDIENCE on the backend character for character,
# trailing slash included.
VITE_AUTH0_AUDIENCE=https://api.driftway.app
